; The unwind information of an epilogue: where the frame of the caller is
; behind each instruction that takes the frame down.

declare i32 @g(i32)
declare void @h(ptr)
declare void @die(i32) noreturn

; The last pop goes to the delay slot of the return.  What the unwind
; information would say behind it is dropped: at the return the pop has not
; run, and behind the two nothing of this function runs.
define i32 @slot(i32 %a, i32 %b) uwtable {
; CHECK-LABEL: slot:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0: ! %entry
; CHECK-NEXT:    mov.l r8,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_offset r8, -4
; CHECK-NEXT:    mov.l r9,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    .cfi_offset r9, -8
; CHECK-NEXT:    mov.l r10,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 12
; CHECK-NEXT:    .cfi_offset r10, -12
; CHECK-NEXT:    sts.l pr,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 16
; CHECK-NEXT:    .cfi_offset pr, -16
; CHECK-NEXT:    mov r4,r8
; CHECK-NEXT:    mov.l .Ltmp0,r10
; CHECK-NEXT:    jsr @r10
; CHECK-NEXT:    mov r5,r4
; CHECK-NEXT:    mov r0,r9
; CHECK-NEXT:    jsr @r10
; CHECK-NEXT:    mov r8,r4
; CHECK-NEXT:    add r9,r0
; CHECK-NEXT:    lds.l @r15+,pr
; CHECK-NEXT:    .cfi_def_cfa_offset 12
; CHECK-NEXT:    .cfi_restore pr
; CHECK-NEXT:    mov.l @r15+,r10
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    .cfi_restore r10
; CHECK-NEXT:    mov.l @r15+,r9
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_restore r9
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.l @r15+,r8
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    .ualong g
entry:
  %x = call i32 @g(i32 %b)
  %y = call i32 @g(i32 %a)
  %s = add i32 %x, %y
  ret i32 %s
}

; The locals go first, and from there on the frame is counted from the
; stack pointer without them.
define i32 @locals(i32 %a) uwtable {
; CHECK-LABEL: locals:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0: ! %entry
; CHECK-NEXT:    sts.l pr,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_offset pr, -4
; CHECK-NEXT:    add #-16,r15
; CHECK-NEXT:    .cfi_def_cfa_offset 20
; CHECK-NEXT:    mov.l r4,@r15
; CHECK-NEXT:    mov.l .Ltmp1,r1
; CHECK-NEXT:    jsr @r1
; CHECK-NEXT:    mov r15,r4
; CHECK-NEXT:    mov.l @(12,r15),r0
; CHECK-NEXT:    add #16,r15
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    lds.l @r15+,pr
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    .cfi_restore pr
; CHECK-NEXT:    rts
; CHECK-NEXT:    nop
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    .ualong h
entry:
  %v = alloca [4 x i32]
  store volatile i32 %a, ptr %v
  call void @h(ptr %v)
  %p = getelementptr i32, ptr %v, i32 3
  %x = load volatile i32, ptr %p
  ret i32 %x
}

; With r14 as the frame pointer the frame is counted from r15 again before
; r14 gets the value of the caller back.
define i32 @variable(i32 %n) uwtable {
; CHECK-LABEL: variable:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0: ! %entry
; CHECK-NEXT:    mov.l r8,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_offset r8, -4
; CHECK-NEXT:    mov.l r14,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    .cfi_offset r14, -8
; CHECK-NEXT:    sts.l pr,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 12
; CHECK-NEXT:    .cfi_offset pr, -12
; CHECK-NEXT:    mov r15,r14
; CHECK-NEXT:    .cfi_def_cfa_register r14
; CHECK-NEXT:    add #3,r4
; CHECK-NEXT:    mov #-4,r2
; CHECK-NEXT:    and r4,r2
; CHECK-NEXT:    mov r15,r8
; CHECK-NEXT:    sub r2,r8
; CHECK-NEXT:    mov r8,r15
; CHECK-NEXT:    mov #1,r1
; CHECK-NEXT:    mov.b r1,@r8
; CHECK-NEXT:    mov.l .Ltmp2,r1
; CHECK-NEXT:    jsr @r1
; CHECK-NEXT:    mov r8,r4
; CHECK-NEXT:    mov.b @r8,r0
; CHECK-NEXT:    mov r14,r15
; CHECK-NEXT:    .cfi_def_cfa r15, 12
; CHECK-NEXT:    lds.l @r15+,pr
; CHECK-NEXT:    .cfi_def_cfa_offset 8
; CHECK-NEXT:    .cfi_restore pr
; CHECK-NEXT:    mov.l @r15+,r14
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_restore r14
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.l @r15+,r8
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:  .Ltmp2:
; CHECK-NEXT:    .ualong h
entry:
  %v = alloca i8, i32 %n
  store volatile i8 1, ptr %v
  call void @h(ptr %v)
  %x = load volatile i8, ptr %v
  %e = sext i8 %x to i32
  ret i32 %e
}

