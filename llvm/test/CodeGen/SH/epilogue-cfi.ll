; CHECK-NEXT:  .LBB3_2: ! %bad
; CHECK-NEXT:    .cfi_restore_state
; CHECK-NEXT:    mov.l .Ltmp5,r1
; CHECK-NEXT:    jsr @r1
; CHECK-NEXT:    nop
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.3:
; CHECK-NEXT:  .Ltmp3:
; CHECK-NEXT:    .ualong h
; CHECK-NEXT:  .Ltmp4:
; CHECK-NEXT:    .ualong g
; CHECK-NEXT:  .Ltmp5:
; CHECK-NEXT:    .ualong die
entry:
  %v = alloca [4 x i32]
  store volatile i32 %a, ptr %v
  call void @h(ptr %v)
