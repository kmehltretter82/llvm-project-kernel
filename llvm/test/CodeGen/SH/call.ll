; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    .ualong callee4
  %r = call i32 @callee4(i32 1, i32 2, i32 3, i32 %a)
  ret i32 %r
}

