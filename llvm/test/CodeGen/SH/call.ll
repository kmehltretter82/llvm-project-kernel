; CHECK-NEXT:    .cfi_offset pr, -4
; CHECK-NEXT:    mov r4,r7
; CHECK-NEXT:    mov.l .Ltmp0,r1
; CHECK-NEXT:    mov #1,r4
; CHECK-NEXT:    mov #2,r5
; CHECK-NEXT:    jsr @r1
; CHECK-NEXT:    mov #3,r6
; CHECK-NEXT:    lds.l @r15+,pr
