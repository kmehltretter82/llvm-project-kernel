; mov.b and mov.w extend the sign, and only mov.l has a displacement.

define i32 @load32(ptr %p) {
; CHECK-LABEL: load32:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.l @r4,r0
  %r = load i32, ptr %p
  ret i32 %r
}

