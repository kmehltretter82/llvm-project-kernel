; CHECK-NEXT:    mov.l @r1,r0
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    .ualong g
  %r = load i32, ptr @g
  ret i32 %r
}

