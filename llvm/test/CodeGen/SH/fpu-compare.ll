declare void @f()

; The change of the precision stands between the comparison and the branch:
; it leaves T alone.
define void @branch(float %a, float %b) {
; CHECK-LABEL: branch:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    sts.l pr,@-r15
; CHECK-NEXT:    .cfi_def_cfa_offset 4
; CHECK-NEXT:    .cfi_offset pr, -4
; CHECK-NEXT:    mov #8,r1
; CHECK-NEXT:    shll16 r1
; CHECK-NEXT:    sts fpscr,r2
; CHECK-NEXT:    xor r1,r2
; CHECK-NEXT:    lds r2,fpscr
; CHECK-NEXT:    fcmp/gt fr5,fr4
; CHECK-NEXT:    mov #8,r1
; CHECK-NEXT:    shll16 r1
; CHECK-NEXT:    sts fpscr,r2
; CHECK-NEXT:    xor r1,r2
; CHECK-NEXT:    lds r2,fpscr
; CHECK-NEXT:    bf .LBB8_2
; CHECK-NEXT:  ! %bb.1: ! %t
; CHECK-NEXT:    mov.l .Ltmp0,r1
; CHECK-NEXT:    jsr @r1
; CHECK-NEXT:    nop
; CHECK-NEXT:  .LBB8_2: ! %e
; CHECK-NEXT:    lds.l @r15+,pr
; CHECK-NEXT:    rts
; CHECK-NEXT:    nop
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.3:
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    .ualong f
  %c = fcmp olt float %a, %b
  br i1 %c, label %t, label %e
t:
  call void @f()
  ret void
e:
  ret void
}

define double @select(double %a, double %b, double %x, double %y) {
; CHECK-LABEL: select:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    fmov fr8,fr0
; CHECK-NEXT:    fmov fr9,fr1
; CHECK-NEXT:    fcmp/gt dr6,dr4
; CHECK-NEXT:    bt .LBB9_2
; CHECK-NEXT:  ! %bb.1:
; CHECK-NEXT:    fmov fr10,fr0
; CHECK-NEXT:    fmov fr11,fr1
; CHECK-NEXT:  .LBB9_2:
; CHECK-NEXT:    rts
; CHECK-NEXT:    nop
  %c = fcmp ogt double %a, %b
