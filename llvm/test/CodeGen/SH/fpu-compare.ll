; fcmp/eq and fcmp/gt are false if an operand is not a number.  They and
; their opposites are six of the conditions, the others are made from them.

define i32 @oeq(double %a, double %b) {
; CHECK-LABEL: oeq:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    fcmp/eq dr6,dr4
; CHECK-NEXT:    rts
; CHECK-NEXT:    movt r0
  %c = fcmp oeq double %a, %b
  %r = zext i1 %c to i32
  ret i32 %r
}

