; __builtin_trap() is the instruction code that every SuperH leaves
; undefined, not a call of abort(), which a kernel does not have.  GNU as
; has no name for it.  It is not put behind a branch: there it would raise
; the exception for an illegal instruction in a delay slot.

declare void @llvm.trap()
declare void @llvm.debugtrap()
declare void @llvm.ubsantrap(i8)
declare void @callee(i32)

; OBJ:    fd ff         .word 0xfffd
; OBJ-EB: ff fd         .word 0xfffd

define void @trap() {
; CHECK-LABEL: trap:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    .word 0xfffd
  call void @llvm.trap()
  unreachable
}

define void @conditional(i32 %x) {
; CHECK-LABEL: conditional:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    tst r4,r4
; CHECK-NEXT:    bf .LBB1_1
; CHECK-NEXT:  ! %bb.2: ! %ok
; CHECK-NEXT:    mov.l .Ltmp0,r1
; CHECK-NEXT:    jmp @r1
; CHECK-NEXT:    mov #0,r4
; CHECK-NEXT:  .LBB1_1: ! %bad
; CHECK-NEXT:    .word 0xfffd
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  ! %bb.3:
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    .ualong callee
  %c = icmp eq i32 %x, 0
  br i1 %c, label %ok, label %bad

ok:
  tail call void @callee(i32 0)
  ret void

bad:
  call void @llvm.trap()
  unreachable
}

