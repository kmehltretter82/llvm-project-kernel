define void @ubsantrap(i32 %x) {
; CHECK-LABEL: ubsantrap:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    mov #9,r1
; CHECK-NEXT:    cmp/hi r1,r4
; CHECK-NEXT:    bt .LBB4_2
; CHECK-NEXT:  ! %bb.1: ! %ok
; CHECK-NEXT:    rts
; CHECK-NEXT:    nop
; CHECK-NEXT:  .LBB4_2: ! %bad
; CHECK-NEXT:    .word 0xfffd
  %c = icmp ult i32 %x, 10
  br i1 %c, label %ok, label %bad

ok:
