; SINGLE-NEXT:  ! %bb.0:
; SINGLE-NEXT:    add #8,r4
; SINGLE-NEXT:    fmov.s fr4,@-r4
; SINGLE-NEXT:    fmov.s fr5,@-r4
; SINGLE-NEXT:    rts
; SINGLE-NEXT:    nop
  store double %v, ptr %p
  ret void
}

define float @fload(ptr %p) {
; SH4-LABEL: fload:
; SH4:         .cfi_startproc
; SH4-NEXT:  ! %bb.0:
; SH4-NEXT:    add #12,r4
; SH4-NEXT:    fmov.s @r4,fr0
; SH4-NEXT:    rts
; SH4-NEXT:    nop
;
; SH4A-LABEL: fload:
; SH4A:         .cfi_startproc
; SH4A-NEXT:  ! %bb.0:
; SH4A-NEXT:    add #12,r4
; SH4A-NEXT:    fmov.s @r4,fr0
; SH4A-NEXT:    rts
; SH4A-NEXT:    nop
;
; SINGLE-LABEL: fload:
; SINGLE:         .cfi_startproc
; SINGLE-NEXT:  ! %bb.0:
; SINGLE-NEXT:    add #12,r4
; SINGLE-NEXT:    fmov.s @r4,fr0
; SINGLE-NEXT:    rts
; SINGLE-NEXT:    nop
  %q = getelementptr float, ptr %p, i32 3
  %r = load float, ptr %q
  ret float %r
}

declare double @ext(double)

