; SH4-NEXT:    lds r2,fpscr
; SH4-NEXT:    fmov.s @r15+,fr12
; SH4-NEXT:    lds.l @r15+,pr
; SH4-NEXT:    rts
; SH4-NEXT:    nop
; SH4-NEXT:    .p2align 2
; SH4-NEXT:  ! %bb.1:
; SH4-NEXT:  .Ltmp1:
; SH4-NEXT:    .ualong ext
;
; SH4A-LABEL: across_call:
; SH4A:         .cfi_startproc
; SH4A-NEXT:  ! %bb.0:
