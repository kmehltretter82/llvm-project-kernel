; SH4:         .cfi_startproc
; SH4-NEXT:  ! %bb.0:
; SH4-NEXT:    fmov.s @r4+,fr1
; SH4-NEXT:    fmov.s @r4,fr0
; SH4-NEXT:    add #-4,r4
; SH4-NEXT:    rts
; SH4-NEXT:    nop
;
; SH4A-LABEL: load:
; SH4A:         .cfi_startproc
; SH4A-NEXT:  ! %bb.0:
; SH4A-NEXT:    fmov.s @r4+,fr1
; SH4A-NEXT:    fmov.s @r4,fr0
; SH4A-NEXT:    add #-4,r4
; SH4A-NEXT:    rts
; SH4A-NEXT:    nop
;
; SINGLE-LABEL: load:
; SINGLE:         .cfi_startproc
; SINGLE-NEXT:  ! %bb.0:
; SINGLE-NEXT:    fmov.s @r4+,fr1
; SINGLE-NEXT:    fmov.s @r4,fr0
; SINGLE-NEXT:    add #-4,r4
; SINGLE-NEXT:    rts
; SINGLE-NEXT:    nop
  %r = load double, ptr %p
  ret double %r
}

define void @store(ptr %p, double %v) {
; SH4-LABEL: store:
; SH4:         .cfi_startproc
; SH4-NEXT:  ! %bb.0:
; SH4-NEXT:    add #8,r4
; SH4-NEXT:    fmov.s fr4,@-r4
; SH4-NEXT:    fmov.s fr5,@-r4
; SH4-NEXT:    rts
; SH4-NEXT:    nop
;
; SH4A-LABEL: store:
; SH4A:         .cfi_startproc
; SH4A-NEXT:  ! %bb.0:
; SH4A-NEXT:    add #8,r4
; SH4A-NEXT:    fmov.s fr4,@-r4
; SH4A-NEXT:    fmov.s fr5,@-r4
; SH4A-NEXT:    rts
; SH4A-NEXT:    nop
;
; SINGLE-LABEL: store:
