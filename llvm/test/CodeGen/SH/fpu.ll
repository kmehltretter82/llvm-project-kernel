; SINGLE-NEXT:    xor r1,r2
; SINGLE-NEXT:    lds r2,fpscr
; SINGLE-NEXT:    flds fr12,fpul
; SINGLE-NEXT:    fcnvsd fpul,dr4
; SINGLE-NEXT:    mov.l .Ltmp1,r1
