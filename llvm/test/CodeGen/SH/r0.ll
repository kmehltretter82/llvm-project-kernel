define void @store_word(ptr %p, i32 %v) {
; CHECK-LABEL: store_word:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    mov r5,r0
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.w r0,@(8,r4)
  %q = getelementptr %struct.s, ptr %p, i32 0, i32 4
  %t = trunc i32 %v to i16
  store i16 %t, ptr %q
  ret void
}

; A displacement has four bits: 30 is the last one for a word, 32 is not.
define i32 @last(ptr %p) {
; CHECK-LABEL: last:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.w @(30,r4),r0
  %q = getelementptr i8, ptr %p, i32 30
  %v = load i16, ptr %q
  %r = sext i16 %v to i32
  ret i32 %r
}

define i32 @beyond(ptr %p) {
; CHECK-LABEL: beyond:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    add #32,r4
; CHECK-NEXT:    rts
; CHECK-NEXT:    mov.w @r4,r0
  %q = getelementptr i8, ptr %p, i32 32
  %v = load i16, ptr %q
  %r = sext i16 %v to i32
  ret i32 %r
}

; r0 is taken by the first value while the second is loaded.
define i32 @both(ptr %p) {
; CHECK-LABEL: both:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ! %bb.0:
; CHECK-NEXT:    mov.w @(6,r4),r0
; CHECK-NEXT:    mov r0,r1
; CHECK-NEXT:    mov.b @(4,r4),r0
; CHECK-NEXT:    mul.l r1,r0
; CHECK-NEXT:    rts
; CHECK-NEXT:    sts macl,r0
  %q1 = getelementptr %struct.s, ptr %p, i32 0, i32 1
  %q2 = getelementptr %struct.s, ptr %p, i32 0, i32 3
  %a = load i8, ptr %q1
  %b = load i16, ptr %q2
  %x = sext i8 %a to i32
  %y = sext i16 %b to i32
  %r = mul i32 %x, %y
  ret i32 %r
}
