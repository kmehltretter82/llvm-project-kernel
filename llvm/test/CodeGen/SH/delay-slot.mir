# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=sh4-unknown-linux-gnu -mcpu=sh4 -run-pass=sh-delay-slot -verify-machineinstrs -o - %s | FileCheck %s

# The rules of the pass that fills the delay slots, one function for each.
# A branch and what is in its slot are one bundle.  An instruction that was
# moved there is in front of the branch in it, a nop is behind it.

# The instruction in front of the branch goes behind it.
---
name:            in_front
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4

    ; CHECK-LABEL: name: in_front
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = MOVLld killed $r4, 0
    ; CHECK-NEXT: $r0 = ADDri killed $r0, 3 {
    ; CHECK-NEXT:   RTS $r0
    ; CHECK-NEXT: }
    $r0 = MOVLld killed $r4, 0
    $r0 = ADDri killed $r0, 3
    RTS $r0
...

# jsr reads its target before the slot runs, so what sets the target stays
# in front.  The pass looks further back: the addition goes over the copy.
# Nothing is taken from in front of a call.
---
name:            target
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: target
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = MOVrr killed $r5
    ; CHECK-NEXT: $r4 = ADDri killed $r4, 1 {
    ; CHECK-NEXT:   JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r4 = ADDri killed $r4, 1
    $r1 = MOVrr killed $r5
    JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# The same for jmp.  The copy is moved over a load: it is not one itself.
---
name:            indirect
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: indirect
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $r4, $r5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r1 = MOVLld killed $r4, 0
  ; CHECK-NEXT:   $r0 = MOVrr killed $r5 {
  ; CHECK-NEXT:     JMP killed $r1
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RTS $r0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1
    liveins: $r4, $r5

    $r0 = MOVrr killed $r5
    $r1 = MOVLld killed $r4, 0
    JMP killed $r1

  bb.1:
    liveins: $r0

    RTS $r0
...

# rts has read pr before the slot runs.
---
name:            link_rts
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r15

    ; CHECK-LABEL: name: link_rts
    ; CHECK: liveins: $r15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: POPPR implicit-def $r15, implicit-def $pr, implicit $r15
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    POPPR implicit-def $r15, implicit-def $pr, implicit $r15
    RTS
...

# But pr can be read behind rts.
---
name:            link_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $pr

    ; CHECK-LABEL: name: link_read
    ; CHECK: liveins: $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = STSPR implicit $pr {
    ; CHECK-NEXT:   RTS $r0
    ; CHECK-NEXT: }
    $r0 = STSPR implicit $pr
    RTS $r0
...

# jsr has written pr before the slot runs.
---
name:            link_jsr
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $pr

    ; CHECK-LABEL: name: link_jsr
    ; CHECK: liveins: $r4, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r5 = STSPR implicit $pr
    ; CHECK-NEXT: JSR killed $r4, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r5 = STSPR implicit $pr
    JSR killed $r4, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# Not over an instruction that reads what it writes.
---
name:            over_reader
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4

    ; CHECK-LABEL: name: over_reader
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r4 = ADDri killed $r4, 1
    ; CHECK-NEXT: $r1 = MOVrr $r4
    ; CHECK-NEXT: JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r4 = ADDri killed $r4, 1
    $r1 = MOVrr $r4
    JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# Not over one that writes what it reads.
---
name:            over_writer
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r4

    ; CHECK-LABEL: name: over_writer
    ; CHECK: liveins: $r1, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r5 = MOVrr killed $r1
    ; CHECK-NEXT: $r1 = MOVrr killed $r4
    ; CHECK-NEXT: JSR killed $r1, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r5 = MOVrr killed $r1
    $r1 = MOVrr killed $r4
    JSR killed $r1, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# What it reads stays alive behind the instructions that it is moved over:
# the second copy no longer ends r4.
---
name:            kill
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4

    ; CHECK-LABEL: name: kill
    ; CHECK: liveins: $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = MOVrr $r4
    ; CHECK-NEXT: $r5 = MOVrr $r4 {
    ; CHECK-NEXT:   JSR killed $r1, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r5 = MOVrr $r4
    $r1 = MOVrr killed $r4
    JSR killed $r1, $r5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# An operation of the floating point unit is not moved over a change of the
# precision.  The change itself cannot go to the slot here, because the copy
# overwrites the register that it reads.
---
name:            precision
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3, $r4, $fr4, $fr5

    ; CHECK-LABEL: name: precision
    ; CHECK: liveins: $r3, $r4, $fr4, $fr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $fr5 = FADDS killed $fr5, killed $fr4, implicit $fpscr
    ; CHECK-NEXT: LDSFPSCR killed $r3, implicit-def $fpscr
    ; CHECK-NEXT: $r3 = MOVrr killed $r4
    ; CHECK-NEXT: JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $fr5 = FADDS killed $fr5, killed $fr4, implicit $fpscr
    LDSFPSCR killed $r3, implicit-def $fpscr
    $r3 = MOVrr killed $r4
    JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# A conversion depends on the precision as well.
---
name:            precision_conversion
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3, $r4

    ; CHECK-LABEL: name: precision_conversion
    ; CHECK: liveins: $r3, $r4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $fr5 = FLOATfpulS implicit $fpul, implicit $fpscr
    ; CHECK-NEXT: LDSFPSCR killed $r3, implicit-def $fpscr
    ; CHECK-NEXT: $r3 = MOVrr killed $r4
    ; CHECK-NEXT: JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $fr5 = FLOATfpulS implicit $fpul, implicit $fpscr
    LDSFPSCR killed $r3, implicit-def $fpscr
    $r3 = MOVrr killed $r4
    JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# Without a change in between the operation is moved.
---
name:            precision_same
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $fr4, $fr5

    ; CHECK-LABEL: name: precision_same
    ; CHECK: liveins: $r4, $fr4, $fr5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r3 = MOVrr killed $r4
    ; CHECK-NEXT: $fr5 = FADDS killed $fr5, killed $fr4, implicit $fpscr {
    ; CHECK-NEXT:   JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $fr5 = FADDS killed $fr5, killed $fr4, implicit $fpscr
    $r3 = MOVrr killed $r4
    JSR killed $r3, $fr5, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# Loads and stores keep their order: the load is not moved over the store,
# which stays where it is because the copy overwrites what it stores.
---
name:            memory
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r3, $r4, $r5, $r6

    ; CHECK-LABEL: name: memory
    ; CHECK: liveins: $r3, $r4, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r0 = MOVLld killed $r4, 0
    ; CHECK-NEXT: MOVLst killed $r3, killed $r5, 0
    ; CHECK-NEXT: $r3 = MOVrr killed $r6
    ; CHECK-NEXT: JSR killed $r3, $r0, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r0 = MOVLld killed $r4, 0
    MOVLst killed $r3, killed $r5, 0
    $r3 = MOVrr killed $r6
    JSR killed $r3, $r0, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# An addition is moved over the store.
---
name:            memory_other
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r3, $r5, $r6

    ; CHECK-LABEL: name: memory_other
    ; CHECK: liveins: $r0, $r3, $r5, $r6
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: MOVLst killed $r3, killed $r5, 0
    ; CHECK-NEXT: $r3 = MOVrr killed $r6
    ; CHECK-NEXT: $r0 = ADDri killed $r0, 1 {
    ; CHECK-NEXT:   JSR killed $r3, $r0, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r0 = ADDri killed $r0, 1
    MOVLst killed $r3, killed $r5, 0
    $r3 = MOVrr killed $r6
    JSR killed $r3, $r0, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# A load that is relative to the program counter cannot be in a slot.
---
name:            literal
tracksRegLiveness: true
body:             |
  bb.0:
    ; CHECK-LABEL: name: literal
    ; CHECK: $r0 = MOVLpc <mcsymbol .Ltmp0>
    ; CHECK-NEXT: RTS $r0 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r0 = MOVLpc <mcsymbol .Ltmp0>
    RTS $r0
...

# Nothing is moved over unwind information.
---
name:            unwind
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5

    ; CHECK-LABEL: name: unwind
    ; CHECK: liveins: $r4, $r5
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r4 = ADDri killed $r4, 1
    ; CHECK-NEXT: CFI_INSTRUCTION def_cfa_offset 4
    ; CHECK-NEXT: $r1 = MOVrr killed $r5
    ; CHECK-NEXT: JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15 {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    ; CHECK-NEXT: RTS {
    ; CHECK-NEXT:   NOP
    ; CHECK-NEXT: }
    $r4 = ADDri killed $r4, 1
    CFI_INSTRUCTION def_cfa_offset 4
    $r1 = MOVrr killed $r5
    JSR killed $r1, $r4, csr_sh_fpu, implicit-def dead $pr, implicit-def dead $t, implicit-def dead $mach, implicit-def dead $macl, implicit-def $r15
    RTS
...

# bra takes the instruction in front of it, but nothing from in front of a
# conditional branch.
---
name:            branches
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: branches
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $r4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = MOVI 1
  ; CHECK-NEXT:   TST $r4, killed $r4, implicit-def $t
  ; CHECK-NEXT:   BT %bb.1, implicit killed $t
  ; CHECK-NEXT:   BRA %bb.2 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = ADDri killed $r0, 1 {
  ; CHECK-NEXT:     BRA %bb.3
  ; CHECK-NEXT:   }
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = ADDri killed $r0, 2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RTS $r0 {
  ; CHECK-NEXT:     NOP
  ; CHECK-NEXT:   }
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4

    $r0 = MOVI 1
    TST $r4, killed $r4, implicit-def $t
    BT %bb.1, implicit killed $t
    BRA %bb.2

  bb.1:
    successors: %bb.3
    liveins: $r0

    $r0 = ADDri killed $r0, 1
    BRA %bb.3

  bb.2:
    successors: %bb.3
    liveins: $r0

    $r0 = ADDri killed $r0, 2

  bb.3:
    liveins: $r0

    RTS $r0
...
