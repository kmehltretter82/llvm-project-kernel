BUILTIN(__builtin_alpha_unpkbl, "ULiULi", "nc")
BUILTIN(__builtin_alpha_unpkbw, "ULiULi", "nc")
BUILTIN(__builtin_alpha_cmpbge, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_extbl, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_extwl, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_extll, "ULiULiULi", "nc")
