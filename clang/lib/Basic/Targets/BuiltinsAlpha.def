BUILTIN(__builtin_alpha_inswh, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_inslh, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_insqh, "ULiULiULi", "nc")
BUILTIN(__builtin_alpha_mskbl, "ULiULiULi", "nc")
