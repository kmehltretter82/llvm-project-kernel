//===----------------------------------------------------------------------===//
//
// The builtin functions that GCC has for Alpha, for the frontend-only target
// in ParseOnly.cpp.  They work on 64-bit quantities, which GCC declares as
// unsigned long.
//
//===----------------------------------------------------------------------===//

// The format of this database matches clang/Basic/Builtins.def.

BUILTIN(__builtin_alpha_implver, "ULi", "nc")
BUILTIN(__builtin_alpha_rpcc, "ULi", "n")
BUILTIN(__builtin_alpha_amask, "ULiULi", "nc")
BUILTIN(__builtin_alpha_cttz, "ULiULi", "nc")
BUILTIN(__builtin_alpha_ctlz, "ULiULi", "nc")
