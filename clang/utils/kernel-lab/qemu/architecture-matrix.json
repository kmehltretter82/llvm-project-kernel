      "family": "riscv",
      "status": "open",
      "source_file": "hw/intc/sifive_plic.c",
      "source_evidence": [
        "static void sifive_plic_irq_request",
        "if (level > 0)",
        "sifive_plic_set_pending(s, irq, true)"
      ],
      "acceptance": "A held level must re-pend after claim/completion until deasserted; a pulse must deliver exactly once; reset and migration must preserve the declared gateway state."
